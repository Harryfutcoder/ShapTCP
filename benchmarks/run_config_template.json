    "checksum_sha256": "",
    "verified_by": "benchmarks/source_notes/<benchmark>.md"
  },
  "protocol": {
    "split": "none|temporal|train_test",
    "leakage_guard": "benchmark_native",
    "k": 20,
    "budget_policy": "count|time",
