{
  "schema_version": 1,
  "id": "benchmark-subject-smoke",
  "evidence_level": "pipeline_validation",
  "claim_scope": "adapter_smoke",
  "source_status": "source-audited",
  "matrix_status": "verified",
  "result_status": "local_smoke_only",
  "source": {
    "benchmark": "OCP|FAST|SIR|Defects4J",
    "artifact_url": "",
    "artifact_commit_or_version": "",
    "local_root_env": "",
    "license_access": ""
  },
  "subject": {
    "project": "",
    "version": "",
    "bug_ids": [],
    "candidate_tests": "benchmark_native"
  },
  "matrix": {
    "path": "data/processed/.../matrix.txt",
    "test_ids_path": "data/processed/.../matrix.txt.tests",
    "entity_ids_path": "data/processed/.../matrix.txt.entities",
    "row_semantics": "test_method|test_class|test_script|ci_job|generated_test",
    "column_semantics": "fault|bug|mutant|statement|branch|method|ci_proxy",
    "value_semantics": "covers|kills|detects|triggering_test_detects_bug|fails_with|co_occurs_with",
    "ground_truth_level": "true_fault|true_bug_metadata|execution_derived_bug|mutant_proxy|coverage_only|ci_proxy",
    "empty_policy": "kept|removed_with_reason",
    "duplicate_policy": "kept|deduplicated_with_mapping",
