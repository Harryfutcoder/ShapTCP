    "random_seeds": 30
  },
  "methods": [
    "random",
    "total",
    "additional",
    "static_shapley",
    "shaptcp"
  ],
  "metrics": [
    "apfd",
    "apfdc",
    "fault_recall_at_k",
    "rare_fault_recall_at_k",
    "redundancy_at_k"
