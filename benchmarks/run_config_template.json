  "baseline_compatibility": {
    "candidate_tests": "aligned",
    "observable_information": "aligned",
    "split": "aligned",
    "budget": "aligned",
    "metric_definition": "aligned",
    "duration_source": "aligned|not_applicable"
  },
  "outputs": {
    "run_id": "benchmark-subject-smoke",
    "results_csv": "outputs/benchmark-subject-smoke/results.csv",
    "orders_dir": "outputs/benchmark-subject-smoke/orders",
    "traces_dir": "outputs/benchmark-subject-smoke/traces",
    "logs_dir": "outputs/benchmark-subject-smoke/logs"
  },
  "claim_boundary": {
    "allowed": [
      "pipeline validation on a confirmed matrix"
    ],
    "disallowed": [
      "SOTA claim",
      "APFD guarantee",
      "treating coverage columns as true faults"
    ]
  }
